# Copier en .env puis remplir. Ne jamais committer .env.

# Périmètre pilote (codes département séparés par des virgules)
ATLAS_DEPARTEMENTS=33,13,59
ATLAS_DVF_PERIODES=2021-s2,2022,2023,2024,2025,2026-s1
ATLAS_DATA_DIR=./data

# PostgreSQL / PostGIS
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas
# 127.0.0.1 et non localhost : le port est lié à l'IPv4 de bouclage seulement ; sous
# Windows, localhost essaie d'abord ::1 (≈ 5 s perdues par connexion).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Rôles en lecture seule (infra/db/roles.sql) : API et tuiles Martin. 16 caractères au
# moins, différents l'un de l'autre et du propriétaire. Valeurs d'exemple à remplacer.
ATLAS_API_DB_PASSWORD=change-me-api-readonly
ATLAS_TILES_DB_PASSWORD=change-me-tiles-readonly

# API
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT=60/minute
# IP (ou CIDR, séparés par des virgules) du reverse proxy dont uvicorn croit
# X-Forwarded-For. Jamais « * » si l'API est joignable sans passer par ce proxy.
API_FORWARDED_ALLOW_IPS=127.0.0.1

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
