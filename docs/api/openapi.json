    "/hex": {
      "get": {
        "description": "Lus dans gold.agg_hex (≥ 5 ventes, suppression secondaire, prix arrondis à 10 €/m², ADR 0005) ; jamais calculés à la volée. Hexagones dont le centre est dans l'emprise. Au-delà du plafond de lignes, la requête est refusée (réduire l'emprise).",
        "operationId": "hex_cells_hex_get",
        "parameters": [
          {
            "description": "Emprise « xmin,ymin,xmax,ymax » en degrés WGS 84 (EPSG:4326)",
            "in": "query",
            "name": "bbox",
            "required": true,
            "schema": {
              "description": "Emprise « xmin,ymin,xmax,ymax » en degrés WGS 84 (EPSG:4326)",
              "examples": [
                "-0.75,44.75,-0.45,44.95"
              ],
              "maxLength": 120,
              "title": "Bbox",
              "type": "string"
            }
          },
          {
            "description": "Résolution H3 : 7 (≈ 5 km²) ou 9 (≈ 0,1 km²)",
            "in": "query",
            "name": "res",
            "required": true,
            "schema": {
              "description": "Résolution H3 : 7 (≈ 5 km²) ou 9 (≈ 0,1 km²)",
              "maximum": 9,
              "minimum": 7,
              "title": "Res",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "default": "tous",
              "enum": [
                "Maison",
                "Appartement",
                "tous"
              ],
              "title": "Type",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "dpe",
            "required": false,
            "schema": {
              "default": "tous",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E",
                "F",
                "G",
                "tous"
              ],
              "title": "Dpe",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "annee",
            "required": false,
            "schema": {
              "default": "tous",
              "pattern": "^(tous|20\\d\\d)$",
              "title": "Annee",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_list_HexCell__"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Paramètres refusés"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Ressource introuvable"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Paramètres invalides"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
