              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Ressource introuvable"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Paramètres invalides"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Trop de requêtes"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Base, modèle ou géocodage indisponible"
          }
        },
        "summary": "Estimation d'un bien fictif par coordonnées et projection 2050"
      },
      "post": {
        "description": "Corps JSON : position (lat+lon, ou adresse géocodée par la BAN, jamais journalisée ni renvoyée) et caractéristiques. Renvoie le prix/m² en fourchette P10-P50-P90, les risques actuels de la commune, les scénarios 2050 (statu quo, rénovation en D, sensibilité « nouveau risque » NON CAUSALE à deux bornes, climat : « indisponible (DRIAS) », jamais chiffré) et les principaux facteurs SHAP. Réponse non mise en cache (no-store).",
        "operationId": "estimate_post_estimate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EstimateQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_Estimation_"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Paramètres refusés"
          },
          "404": {
