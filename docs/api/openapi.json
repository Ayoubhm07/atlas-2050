    "/estimate": {
      "get": {
        "description": "Position par lat+lon et caractéristiques en chaîne de requête. Pour une adresse, utiliser POST /estimate (une adresse n'est jamais mise dans une URL). Renvoie le prix/m² en fourchette P10-P50-P90, les risques actuels de la commune, les scénarios 2050 (statu quo, rénovation en D, sensibilité « nouveau risque » NON CAUSALE à deux bornes, climat : « indisponible (DRIAS) », jamais chiffré) et les principaux facteurs SHAP. Réponse non mise en cache (no-store).",
        "operationId": "estimate_estimate_get",
        "parameters": [
          {
            "in": "query",
            "name": "type_local",
            "required": true,
            "schema": {
              "enum": [
                "Maison",
                "Appartement"
              ],
              "title": "Type Local",
              "type": "string"
            }
          },
          {
            "description": "Surface habitable, m²",
            "in": "query",
            "name": "surface",
            "required": true,
            "schema": {
              "description": "Surface habitable, m²",
              "maximum": 1000,
              "minimum": 9,
              "title": "Surface",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "pieces",
            "required": true,
            "schema": {
              "maximum": 30,
              "minimum": 1,
              "title": "Pieces",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "surface_terrain",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 10000,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Surface Terrain"
            }
          },
          {
            "in": "query",
            "name": "dependances",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 10,
              "minimum": 0,
              "title": "Dependances",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "dpe",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E",
                    "F",
                    "G"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Dpe"
            }
          },
          {
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "maximum": 90,
              "minimum": -90,
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "maximum": 180,
              "minimum": -180,
              "title": "Lon",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_Estimation_"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
