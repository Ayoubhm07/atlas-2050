            "title": "N Ventes",
            "type": "integer"
          },
          "prix_m2_median": {
            "title": "Prix M2 Median",
            "type": "number"
          },
          "prix_m2_q1": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "null sous 11 ventes",
            "title": "Prix M2 Q1"
          },
          "prix_m2_q3": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "null sous 11 ventes",
            "title": "Prix M2 Q3"
          },
          "surface_mediane": {
            "description": "Surface habitable médiane, arrondie à 5 m²",
            "title": "Surface Mediane",
            "type": "number"
          },
          "type_local": {
            "title": "Type Local",
            "type": "string"
          }
        },
        "required": [
          "type_local",
          "annee",
          "n_ventes",
          "prix_m2_q1",
          "prix_m2_median",
          "prix_m2_q3",
          "surface_mediane"
        ],
        "title": "StatsGroupe",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API ATLAS 2050.\n\nToutes les réponses suivent l'enveloppe {success, data, error, meta}. Aucune vente isolée ni adresse n'est renvoyée (ADR 0005). Tuiles vectorielles : Martin (docs/api/README.md).",
