          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Base, modèle ou géocodage indisponible"
          }
        },
        "summary": "Estimation d'un bien fictif par adresse ou coordonnées et projection 2050"
      }
